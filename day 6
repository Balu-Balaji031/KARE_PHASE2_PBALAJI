Palindrome 
Steps:
get a number
store n at temp value
reverse a number using right side formation
compare temp an reverse number
if both are equal print palidrome number
*/
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		System.out.print("Enter a number: ");
		int n=sc.nextInt();
		int temp=n;
		int ans=0;
		int d;
		while(n!=0){
		    d=n%10;
		    ans=ans*10+d;
		    n=n/10;
		}
		System.out.print(ans +" ");
		if(temp==ans){
		    System.out.print("Palindrome");
		}else{
		    System.out.print("Not a Palindrome");
		}
	}
}
