// n = 4
//hollow square with diognals
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n = obj.nextInt();
	    n = 2*n-1;
	    for(int i=0;i<n;i++){
	        for(int j=0;j<n;j++){
	            if(i==0 || i==n-1 || j==0 || j==n-1 || i==j || i+j==n-1){
	                System.out.print("*");
	            }
	            else {
	                System.out.print(" ");
	        }
	    }
		System.out.println(" ");
	}
}
}
